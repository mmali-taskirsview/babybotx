generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified Boolean   @default(false)
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  reviews       Review[]
  addresses     Address[]
  securityLogs  SecurityLog[]
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json
  description Json?
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json
  description Json
  price       Decimal   @db.Decimal(10, 2)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  orders      OrderItem[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  provider     String
  providerRef  String     @unique
  status       String     @default("pending")
  total        Decimal    @db.Decimal(10, 2)
  items        OrderItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String  // snapshot
  price     Decimal @db.Decimal(10, 2)
  qty       Int     @default(1)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  body      String?
  createdAt DateTime @default(now())
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  line1  String
  city   String
  country String
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  ip        String?
  createdAt DateTime @default(now())
}
